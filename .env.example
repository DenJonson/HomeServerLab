# ---------------------------------------------------------------------
# Host / DNS
# ---------------------------------------------------------------------

# Tailscale IPv4 address of Raspberry Pi.
# Example: 100.64.12.34
TAILSCALE_IP=100.x.y.z

# MagicDNS hostname or local hostname fallback.
# Example: raspberrypi
TAILSCALE_HOST=raspberrypi

# Internal domain. All service names should resolve to TAILSCALE_IP.
# Example:
# home.pi.home.arpa       -> 100.x.y.z
# grafana.pi.home.arpa    -> 100.x.y.z
# prometheus.pi.home.arpa -> 100.x.y.z
BASE_DOMAIN=pi.home.arpa

# ---------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------

TZ=Europe/Berlin

# ---------------------------------------------------------------------
# Homepage
# ---------------------------------------------------------------------

# Hosts allowed by Homepage.
# Must include all names used to access Homepage through Caddy.
HOMEPAGE_ALLOWED_HOSTS=home.pi.home.arpa,raspberrypi

# ---------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_grafana_password

# ---------------------------------------------------------------------
# External Wiki.js integration
# ---------------------------------------------------------------------

# Wiki.js is NOT managed by this compose project.
# It is expected to be reachable from the Raspberry Pi host by local port.
WIKI_EXTERNAL_PORT=3100
WIKI_EXTERNAL_URL=http://wiki.pi.home.arpa

# ---------------------------------------------------------------------
# Smart-home service
# ---------------------------------------------------------------------

# Placeholder port inside smart-home container.
# Change when real smart-home service is integrated.
SMART_HOME_PORT=8080

# ---------------------------------------------------------------------
# Optional admin services
# ---------------------------------------------------------------------

# Portainer is started only with:
# docker compose --profile admin up -d portainer
PORTAINER_ENABLED=false