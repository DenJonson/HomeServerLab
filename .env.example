# ---------------------------------------------------------------------
# Host / DNS
# ---------------------------------------------------------------------

# Bind Caddy to the Tailscale address so this stack is reachable from
# the tailnet, but not from every interface on the Raspberry Pi.
TAILSCALE_IP=100.x.y.z

# Tailscale MagicDNS name, for example raspberrypi or raspberrypi.tailnet.ts.net.
TAILSCALE_HOST=raspberrypi
BASE_DOMAIN=pi.home.arpa

# ---------------------------------------------------------------------
# Caddy
# ---------------------------------------------------------------------

CADDY_HTTP_PORT=80


# ---------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------

TZ=Europe/Moscow

# ---------------------------------------------------------------------
# Homepage
# ---------------------------------------------------------------------

HOMEPAGE_ALLOWED_HOSTS=home.pi.home.arpa,raspberrypi

# Optional comma-separated list used by scripts/write-compose-project-status-prom.sh.
# Add compose project names that must exist. Missing projects are exported as down.
HOMELAB_EXPECTED_COMPOSE_PROJECTS=homelab-monitoring

# Absolute path on the Raspberry Pi host. This must match the host side of the
# node-exporter textfile volume in compose.yml.
HOMELAB_TEXTFILE_DIR=/opt/homelab/node-exporter/textfile

# ---------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_grafana_password
